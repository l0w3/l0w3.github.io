---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About - 0xl0w3">
    <section class="about-hero">
        <h1>0xl0w3</h1>
        <p class="hero-role">Security Research Engineer</p>
        <p class="hero-tags">Malware development · EDR evasion · Active Directory · Vulnerability research · Hardware hacking</p>
    </section>

    <section class="about-page">
        <div class="about-content">

            <div class="profile-section">
                <h2 class="section-title">About Me</h2>
                <p>
                    Security Research Engineer working on malware development, EDR evasion, and offensive security.
                    I write implants in C and study how modern EDRs detect them. I also map attack paths across
                    Active Directory and Entra ID environments.
                </p>
                <p>
                    My other interests are vulnerability research, mostly Linux kernel and binary exploitation, and
                    hardware hacking, mainly firmware extraction and analysis with a Bus Pirate and SPI flash.
                </p>
                <p>
                    This blog is where I write all of it down, the techniques and the failures.
                </p>
            </div>

            <div class="expertise-section">
                <h2 class="section-title">Areas of Expertise</h2>
                <div class="expertise-grid">
                    <div class="expertise-card">
                        <h3>Malware Development and Evasion</h3>
                        <p>Implant development in C, from EarlyBird APC injection to custom DLL loaders, using Windows internals and the WinAPI.</p>
                    </div>
                    <div class="expertise-card">
                        <h3>Active Directory and Red Team</h3>
                        <p>Attack paths, lateral movement, and full compromise chains in Active Directory and Entra ID. CRTP and CARTP certified.</p>
                    </div>
                    <div class="expertise-card">
                        <h3>Vulnerability Research</h3>
                        <p>Deep dives into the mechanics behind bugs, DirtyCoW's race condition and Sudo's buffer overflow among them, using patch diffing and low-level analysis.</p>
                    </div>
                    <div class="expertise-card">
                        <h3>Hardware Hacking</h3>
                        <p>Firmware extraction and analysis with a Bus Pirate, SPI flash, and binwalk.</p>
                    </div>
                </div>
            </div>

            <div class="skills-section">
                <h2 class="section-title">Technical Skills</h2>
                <div class="skills-categories">
                    <div class="skill-category">
                        <h3>Programming</h3>
                        <div class="skills-list">
                            <span class="skill">C</span>
                            <span class="skill">Python</span>
                            <span class="skill">x64 Assembly</span>
                            <span class="skill">Bash</span>
                        </div>
                    </div>
                    <div class="skill-category">
                        <h3>Offensive Security</h3>
                        <div class="skills-list">
                            <span class="skill">Windows Internals</span>
                            <span class="skill">WinAPI</span>
                            <span class="skill">Process Injection</span>
                            <span class="skill">Evasion</span>
                            <span class="skill">Active Directory</span>
                            <span class="skill">Entra ID</span>
                        </div>
                    </div>
                    <div class="skill-category">
                        <h3>Reverse Engineering</h3>
                        <div class="skills-list">
                            <span class="skill">Ghidra</span>
                            <span class="skill">IDA Pro</span>
                            <span class="skill">GDB</span>
                            <span class="skill">pwntools</span>
                            <span class="skill">Patch Diffing</span>
                            <span class="skill">Binwalk</span>
                        </div>
                    </div>
                    <div class="skill-category">
                        <h3>Detection and Analysis</h3>
                        <div class="skills-list">
                            <span class="skill">EDR Telemetry</span>
                            <span class="skill">Wireshark</span>
                            <span class="skill">Digital Forensics</span>
                        </div>
                    </div>
                    <div class="skill-category">
                        <h3>Hardware</h3>
                        <div class="skills-list">
                            <span class="skill">Bus Pirate</span>
                            <span class="skill">SPI Flash</span>
                            <span class="skill">Flashrom</span>
                            <span class="skill">UART</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="certs-section">
                <h2 class="section-title">Certifications</h2>
                <div class="certs-strip">
                    <a href="/certifications" class="cert-chip">CRTP</a>
                    <a href="/certifications" class="cert-chip">CARTP</a>
                    <a href="/certifications" class="cert-chip">Malware Developer</a>
                    <a href="/certifications" class="cert-chip">Ransomware Internals</a>
                    <a href="/certifications" class="cert-chip">CDFE</a>
                </div>
            </div>

            <div class="contact-section">
                <h2 class="section-title">Get In Touch</h2>
                <div class="contact-links">
                    <a href="mailto:0xl0w3@proton.me" class="contact-link">Email</a>
                    <a href="https://github.com/l0w3" class="contact-link">GitHub</a>
                    <a href="https://www.linkedin.com/in/alex-rodrigez-offensivesec/" class="contact-link">LinkedIn</a>
                </div>
            </div>

        </div>
    </section>
</BaseLayout>

<style>
    .about-hero {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem 1rem;
        text-align: center;
    }

    .about-hero h1 {
        color: #ffc107;
        font-size: 3rem;
        margin-bottom: 0.5rem;
    }

    .hero-role {
        color: #e0e0e0;
        font-size: 1.4rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .hero-tags {
        color: #888;
        font-size: 1rem;
        line-height: 1.7;
    }

    .about-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 2rem 4rem;
    }

    .about-content {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .about-content h3 {
        color: #ffc107;
        font-size: 1.1rem;
        margin-bottom: 0.75rem;
    }

    .about-content p {
        color: #b0b0b0;
        line-height: 1.8;
        font-size: 1.05rem;
    }

    .profile-section,
    .contact-section {
        background: rgba(35, 35, 35, 0.4);
        padding: 2rem;
        border-radius: 8px;
        border: 1px solid rgba(255, 193, 7, 0.1);
    }

    .profile-section p + p {
        margin-top: 1rem;
    }

    .expertise-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .expertise-card {
        background: rgba(35, 35, 35, 0.4);
        padding: 1.5rem;
        border-radius: 8px;
        border: 1px solid rgba(255, 193, 7, 0.1);
        transition: all 0.3s ease;
    }

    .expertise-card:hover {
        background: rgba(45, 45, 45, 0.6);
        border-color: rgba(255, 193, 7, 0.3);
        transform: translateY(-5px);
    }

    .expertise-card p {
        color: #b0b0b0;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .skills-categories {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .skill-category {
        background: rgba(35, 35, 35, 0.4);
        padding: 1.5rem;
        border-radius: 8px;
        border: 1px solid rgba(255, 193, 7, 0.1);
    }

    .skill-category h3 {
        color: #ffc107;
        font-size: 1.1rem;
        margin-bottom: 1rem;
    }

    .skills-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .skill {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .skill:hover {
        background: rgba(255, 193, 7, 0.3);
        transform: scale(1.05);
    }

    .certs-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .cert-chip {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .cert-chip:hover {
        background: #ffc107;
        color: #1a1a1a;
        transform: translateY(-2px);
    }

    .contact-links {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
    }

    .contact-link {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .contact-link:hover {
        background: #ffc107;
        color: #1a1a1a;
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .expertise-grid {
            grid-template-columns: 1fr;
        }

        .contact-links {
            flex-direction: column;
        }

        .contact-link {
            text-align: center;
        }
    }
</style>
